{
  "expo": {
    "name": "Velt Preview",
    "slug": "velt-mobile-preview",
    "version": "0.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.velt.preview",
      "infoPlist": {
        "NSCameraUsageDescription": "Velt Preview uses the camera to scan Velt preview QR codes."
      }
    },
    "android": {
      "package": "com.velt.preview",
      "versionCode": 2,
      "usesCleartextTraffic": true,
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Velt Preview to scan Velt preview QR codes."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b4aba98e-f68a-4347-bb7d-074d299dec30"
      }
    }
  }
}
